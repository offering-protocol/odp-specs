{
  "branding": {
    "icon": {
      "src": "/branding/icon.svg",
      "type": "image/svg+xml"
    },
    "logo": {
      "src": "/branding/logo.webp",
      "type": "image/webp"
    }
  },
  "description": "A marketplace with millions of independent listings across a large taxonomy.",
  "http": {
    "endpoint_base": "/odp/",
    "openapi": {
      "url": "/openapi.json"
    }
  },
  "keywords": [
    "marketplace",
    "handmade",
    "vintage",
    "retail"
  ],
  "language": "en",
  "localizations": [
    "en",
    "ja"
  ],
  "name": "Market Example",
  "odp_version": "1.0",
  "operations": [
    {
      "authentication": "optional",
      "name": "get-collection"
    },
    {
      "authentication": "optional",
      "name": "get-offering"
    },
    {
      "authentication": "optional",
      "name": "list-collection-offerings"
    },
    {
      "authentication": "optional",
      "name": "list-collections"
    },
    {
      "authentication": "optional",
      "name": "list-offerings"
    },
    {
      "authentication": "optional",
      "name": "search-collections"
    },
    {
      "authentication": "optional",
      "name": "search-offerings"
    }
  ],
  "protocols": {
    "enrollment": [
      {
        "name": "aep"
      }
    ],
    "payments": [
      {
        "authentication": "required",
        "name": "mpp"
      },
      {
        "authentication": "not-required",
        "name": "x402"
      }
    ]
  }
}
