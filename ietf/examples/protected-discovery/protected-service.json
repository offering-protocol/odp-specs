{
  "odp_version": "1.0",
  "name": "Protected Catalog Example",
  "description": "A catalog that supports agent enrollment and agentic payment.",
  "language": "en",
  "localizations": [
    "en"
  ],
  "protocols": {
    "enrollment": [
      {
        "name": "aep"
      }
    ],
    "payments": [
      {
        "authentication": "required",
        "name": "mpp"
      },
      {
        "authentication": "required",
        "name": "x402"
      }
    ]
  },
  "operations": [
    {
      "authentication": "required",
      "name": "get-offering"
    },
    {
      "authentication": "required",
      "name": "list-offerings"
    },
    {
      "authentication": "required",
      "name": "search-offerings"
    }
  ],
  "http": {
    "endpoint_base": "/odp/"
  }
}
