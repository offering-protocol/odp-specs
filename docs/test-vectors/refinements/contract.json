    {
      "name": "same-filter-expressions-are-removed-before-counting",
      "operation": "compute-counts",
      "filter_id": "material",
      "request": {
        "filters": [
          {
            "id": "material",
            "operator": "eq",
            "value": "wood"
          },
          {
            "id": "made_to_order",
