      "name": "valid-exact-and-lower-bound-counts",
      "operation": "validate-response",
      "definitions": [
        {
          "id": "material",
          "type": "string",
          "operators": [
            "eq"
          ],
          "refinable": true
        }
      ],
      "request": {
        "refinements": [
          "material"
        ]
      },
      "response": {
        "refinements": [
          {
            "filter_id": "material",
            "values": [
              {
                "value": "wood",
                "count": 18420
              },
              {
                "value": "metal",
                "count": 12681,
                "count_relation": "lower_bound"
              }
            ]
          }
        ]
      },
      "valid": true
    },
